act = {"start": "2026-11-01 20:00", "end": "2026-11-01 22:21", "stage": "Vue in the Light, Screen 7", "act": "9 Temples to Heaven", "type": "film", "url": "https://www.leedsfilm.com/whats-on/9-temples-to-heaven-n4cf", "blurb": "9 Temples to Heaven is a beautiful and hypnotic film about a one-day family pilgrimage.\nSakol hears a prophecy from a fortune teller that his elderly mother may die soon. He corrals three generations of his family to visit nine temples in succession, overcoming personal worries and generational conflict to offer tributes at each one. A gentle, patiently revelatory drama ensues, taking the viewer on a tour of stunning Thai architecture and celebrating magical everyday moments of transcendence."}
