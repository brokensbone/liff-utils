act = {"start": "2026-11-04 13:15", "end": "2026-11-04 15:03", "stage": "Vue in the Light, Screen 12", "act": "Zejtune", "type": "film", "url": "https://www.leedsfilm.com/whats-on/zejtune-mjkx", "blurb": "A spellbinding drama set on the island of Malta, following an extraordinary folk singing tradition, where the vocalists spa with improvised rhyming couplets.\nAfter her estranged mother’s death, Mar plans to leave Malta for good by selling the farmland she’s inherited. But as she travels the island to claim her land, she meets Nenu, an irrepressible 80-year-old folk singer whose music and spirit challenge her desire to escape. Mar slowly warms to the homeland she wanted to turn her back on."}
