act = {"start": "2026-11-02 20:30", "end": "2026-11-02 22:28", "stage": "Hyde Park Picture House, Screen 1", "act": "Atonement", "type": "film", "url": "https://www.leedsfilm.com/whats-on/atonement-rmg7", "blurb": "Anchored by moving performances from Boyd Holbrook, Hiam Abbass (also in In a Whisper at LIFF 2026), and Kenneth Branagh, Atonement is a powerfully human story about the immeasurable costs of war, exploring universal questions about guilt, redemption and the nature of forgiveness.\nIn the early days of the Iraq War, a U.S. Marine’s split-second decision during a firefight devastates an Iraqi family. Years later, haunted by his time in Iraq and aided by a New Yorker journalist, the Marine seeks to reconcile with the surviving family members.\nContains scenes with death and grief."}
